{
  "format": "dshte.theme",
  "formatVersion": 1,
  "release": "1.0.0",
  "id": "fixture-assets",
  "name": "Fixture Assets",
  "nameZh": "样例包",
  "colorScheme": "light",
  "tokens": {
    "light": {
      "--dsw-alias-bg-base": "#FAF9F5",
      "--dsw-alias-bg-layer-1": "#FFFDF8",
      "--dsw-alias-brand-primary": "#CC785C",
      "--dsw-alias-label-primary": "#2E2921",
      "--dsw-alias-label-secondary": "#6B6459",
      "--dsw-alias-border-l1": "#E6E0D6",
      "--dsw-alias-border-l2": "#D5CDC1"
    }
  },
  "typography": {
    "fonts": [
      {
        "family": "Fixture Sans",
        "file": "assets/fonts/fixture.woff2",
        "weight": 400,
        "display": "swap"
      }
    ],
    "sizes": {
      "body": 13
    },
    "tracking": {
      "eyebrow": "0.12em"
    }
  },
  "assets": {
    "preview": "assets/images/preview.svg"
  },
  "css": "theme.css"
}
