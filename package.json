{
  "name": "dsh-tavern-skin-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSHTavern 皮肤引擎（Step 1 骨架：插件加载链路验证，不含皮肤实现）",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "themes",
    "README.md",
    "THEME-PACK.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "pack-check": "node scripts/pack-check.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/build-client.mjs --check && node --test \"tests/**/*.test.mjs\" && node scripts/pack-check.mjs themes/cocreate-paper"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverLark257/DSHT-Skin-Engine.git"
  },
  "homepage": "https://github.com/SilverLark257/DSHT-Skin-Engine#readme",
  "bugs": {
    "url": "https://github.com/SilverLark257/DSHT-Skin-Engine/issues"
  }
}
